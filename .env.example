# ==========================================================
# Tata Group AI Legal Document Intelligence System - ENV
# Copy this file to `.env` and fill in values.
# NEVER commit the real .env file to GitHub.
# ==========================================================

# --- AI Mode ---
# auto    -> use Gemini if GEMINI_API_KEY is set, else offline rule engine
# gemini  -> require Gemini (fails to offline if no key)
# offline -> always use the built-in rule-based engine (no API key needed)
AI_MODE=auto

# --- Gemini (optional) ---
# Get a FREE key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Database ---
DB_PATH=legal_intelligence.db

# --- Auth ---
# CHANGE THESE IN PRODUCTION
SECRET_KEY=tata-legal-demo-secret-change-me
TOKEN_TTL_HOURS=24
ADMIN_EMAIL=admin@tata.com
ADMIN_PASSWORD=tata123

# --- Upload limits ---
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.md,.html,.png,.jpg,.jpeg

# --- Retrieval ---
TOP_K_RETRIEVAL=5

# --- CORS (comma separated; * for open demo) ---
CORS_ORIGINS=*
